# Required: Groq Cloud API key for LLM calls
GROQ_API_KEY=gsk_your_key_here

# Optional: Fixed secret for session signing (auto-generated if missing, but sessions reset on restart)
AUTH_SECRET_KEY=your_fixed_secret_here

# Optional: LLM model override
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Enable LLM content moderation (adds latency)
CONTENT_GUARD_ENABLED=false
